# Servidor
PORT=3333
WEB_ORIGIN=http://localhost:5173

# Supabase Auth — Project Settings > API
# SUPABASE_JWKS_URL = SUPABASE_URL + /auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SECRET_KEY=

# Banco de dados (Postgres do Supabase) — Project Settings > Database > Connect
# Para começar, DATABASE_URL e DIRECT_URL podem ser a mesma connection string
# direta (porta 5432). Se migrar para o pooler (porta 6543) depois, use-o em
# DATABASE_URL e mantenha DIRECT_URL como a conexão direta (necessária para
# o Prisma rodar migrations).
DATABASE_URL=
DIRECT_URL=

# Redis / filas de lembretes (configurado na Etapa 5)
REDIS_URL=

# WhatsApp Cloud API — requer verificação de negócio (CNPJ) na Meta.
# Enquanto não configurado, os lembretes caem automaticamente para SMS
# (se o Twilio estiver configurado) ou para modo simulado.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS via Twilio — alternativa ao WhatsApp que não exige CNPJ.
# Console > Account Info (SID/Token) e Phone Numbers > Manage (número de origem, formato E.164, ex: +15005550006)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push (notificações do navegador) — canal gratuito, complementar aos
# demais. Gere um par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Cakto - pagamentos e assinaturas (configurado na Etapa 8)
CAKTO_WEBHOOK_SECRET=
