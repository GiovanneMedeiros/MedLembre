# Servidor
PORT=3333
WEB_ORIGIN=http://localhost:5173

# Supabase Auth — Project Settings > API
# SUPABASE_JWKS_URL = SUPABASE_URL + /auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SECRET_KEY=

# Banco de dados (Postgres do Supabase, configurado quando o schema de
# domínio — medicamentos, perfis, etc. — for implementado)
DATABASE_URL=
DIRECT_URL=

# Redis / filas de lembretes (configurado na Etapa 5)
REDIS_URL=

# WhatsApp Cloud API (configurado na Etapa 5)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Cakto - pagamentos e assinaturas (configurado na Etapa 8)
CAKTO_WEBHOOK_SECRET=
