# Servidor
PORT=3333
WEB_ORIGIN=http://localhost:5173

# Supabase Auth — Project Settings > API
# SUPABASE_JWKS_URL = SUPABASE_URL + /auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SECRET_KEY=

# Banco de dados (Postgres do Supabase) — Project Settings > Database > Connect
# Para começar, DATABASE_URL e DIRECT_URL podem ser a mesma connection string
# direta (porta 5432). Se migrar para o pooler (porta 6543) depois, use-o em
# DATABASE_URL e mantenha DIRECT_URL como a conexão direta (necessária para
# o Prisma rodar migrations).
DATABASE_URL=
DIRECT_URL=

# Redis / filas de lembretes (configurado na Etapa 5)
REDIS_URL=

# WhatsApp Cloud API (configurado na Etapa 5)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Cakto - pagamentos e assinaturas (configurado na Etapa 8)
CAKTO_WEBHOOK_SECRET=
