generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MedicationStatus {
  ATIVO
  PAUSADO
}

enum Plano {
  GRATIS
  ESSENCIAL
  FAMILIA
  PREMIUM
}

enum ReminderChannel {
  WHATSAPP
  SMS
}

enum SubscriptionStatus {
  ATIVA
  INADIMPLENTE
  CANCELADA
}

enum BillingPeriod {
  MENSAL
  ANUAL
}

enum ReminderStatus {
  ENVIADO
  FALHOU
  SIMULADO
}

// userId referencia auth.users.id (gerenciado pelo Supabase Auth) —
// não é uma FK do Prisma porque essa tabela vive fora do schema public.
model Medication {
  id             String            @id @default(uuid())
  userId         String
  familyMemberId String?
  nome           String
  dosagem        String
  observacao     String?
  horarios       String[]
  diasSemana     Int[]
  dataInicio     DateTime          @db.Date
  dataFim        DateTime?         @db.Date
  status         MedicationStatus  @default(ATIVO)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  doseRecords  DoseRecord[]
  reminderLogs ReminderLog[]

  @@index([userId])
  @@index([familyMemberId])
  @@map("medications")
}

model DoseRecord {
  id           String   @id @default(uuid())
  medicationId String
  userId       String
  scheduledFor DateTime
  takenAt      DateTime @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, scheduledFor])
  @@index([userId, scheduledFor])
  @@map("dose_records")
}

// Representa o plano/assinatura atual do usuário. O status e os dados
// do provedor só são alterados a partir de webhooks assinados do
// gateway de pagamento — o frontend nunca define plano/status
// diretamente. Todo usuário novo começa em GRATIS.
model Subscription {
  id                      String              @id @default(uuid())
  userId                  String              @unique
  plano                   Plano               @default(GRATIS)
  status                  SubscriptionStatus  @default(ATIVA)
  periodicidade           BillingPeriod?
  provider                String?
  providerCustomerId      String?
  providerSubscriptionId  String?             @unique
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean             @default(false)
  // E-mail e plano/periodicidade pretendidos no momento em que o checkout
  // foi gerado. Necessários porque a Cakto (e outros checkouts estáticos
  // sem API de "criar sessão") não devolve um identificador de usuário no
  // webhook — o evento é resolvido casando o e-mail do pagador aqui, e o
  // plano concedido é o que a própria aplicação pretendia, não algo que
  // o provedor precise reportar de volta.
  email                   String?
  pendingPlano            Plano?
  pendingPeriodicidade    BillingPeriod?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([providerCustomerId])
  @@index([email])
  @@map("subscriptions")
}

// Registro de cada evento de webhook recebido do gateway de pagamento.
// providerEventId garante idempotência (o mesmo evento reenviado pelo
// provedor não é processado duas vezes) e serve de trilha de auditoria.
model PaymentEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String   @unique
  type            String
  userId          String?
  rawPayload      Json
  processedAt     DateTime @default(now())

  @@index([userId])
  @@map("payment_events")
}

// Perfil de um familiar acompanhado pelo dono da conta (userId).
// Não possui login próprio — é apenas um perfil dentro da conta do
// responsável, disponível nos planos Família e Premium.
model FamilyMember {
  id        String   @id @default(uuid())
  userId    String
  nome      String
  whatsapp  String?
  fotoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medications Medication[]

  @@index([userId])
  @@map("family_members")
}

// Registra cada tentativa de envio de lembrete pelo WhatsApp e o
// resultado (inclusive quando simulado, por falta de credenciais).
model ReminderLog {
  id                String          @id @default(uuid())
  userId            String
  medicationId      String
  familyMemberId    String?
  scheduledFor      DateTime
  channel           ReminderChannel @default(WHATSAPP)
  status            ReminderStatus
  providerMessageId String?
  snoozedUntil      DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, scheduledFor])
  @@index([userId, scheduledFor])
  @@map("reminder_logs")
}

// Inscrição de um navegador do dono da conta para receber notificações
// push. Só o dono recebe push (familiares não têm login próprio), como
// um canal extra e gratuito além do WhatsApp/SMS.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
